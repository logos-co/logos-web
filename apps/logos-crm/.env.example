DATABASE_URL=postgresql://logos:logos@localhost:5434/logos_crm

# Identity. `none` resolves the acting user server-side and is refused in
# production; `demo` resolves it the same way but is allowed in production and
# labels every screen, which is what the deployed previews run on - put nothing
# but fixtures behind it; `proxy` is the Infra contract, not implemented yet.
AUTH_MODE=none
CRM_DEV_ACTOR_EMAIL=mara.chen@logos.co

# hCaptcha secret for the public funnel intake endpoint. Leave unset locally to
# skip verification; production refuses to start without it.
# HCAPTCHA_SECRET=

# Extra browser origins allowed to post to the public intake endpoint, comma
# separated. logos.co, its Vercel previews, and localhost are already allowed.
# CORS_ALLOWED_ORIGINS=

# Base URL used for the deep links in notification emails.
CRM_PUBLIC_URL=http://localhost:3004

# Infra SMTP relay, used by the worker to send mention notifications. Without it
# the worker runs and deliveries fail visibly rather than disappearing.
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS_ENABLE=true

# Notion bridge import (`pnpm --filter logos-crm import:notion`). The token is
# an internal integration with read access to the intake database.
# NOTION_TOKEN=
# NOTION_INTAKE_DATABASE_ID=

# Scout source adapters. Off by default: with this unset, Scout runs on its
# synthetic catalogue and makes no external request. A GitHub token is optional
# and only raises the rate limit; it does not enable anything.
# SCOUT_SOURCES_ENABLED=true
# GITHUB_TOKEN=
