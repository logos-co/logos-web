# Web frontend env. Copy to apps/web/.env (or .env.local) and fill in.
# Vercel injects most of these via the project settings — local dev needs
# the file.

# --- Mode --------------------------------------------------------------------
# `production` enables search-engine indexing in lib/metadata.ts.
# `staging` / `development` keep robots set to noindex.
NEXT_PUBLIC_API_MODE=development

# --- URLs --------------------------------------------------------------------
# Optional. Public Payload CMS origin (REST + GraphQL at /api/...).
# Only set this when web pages need to call CMS at runtime — preview tokens,
# draft fetches, etc. The default content pipeline reads from local files
# under content/** at build time and does NOT need this var.
# NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Blog CMS (Strapi) and Simplecast keys. Every /media page, the article cards
# on the home and technology stack pages, and the media search index are built
# from the CMS at cms-press.logos.co (fixed in lib/blog-content.ts), and every
# build fails without the Strapi key: the CMS is the only source, there is no
# fallback to blog.logos.co. Production builds also fail without the
# Simplecast token.
# Run `pnpm --filter web generate:media-assets` before `next dev` to get the
# resized images, feeds and search index locally.
# STRAPI_API_KEY=
# SIMPLECAST_ACCESS_TOKEN=

# Outage switch for build-time content fetches: the blog CMS media and the
# active circles API. Unset, a failed fetch fails the build. Set to 1, the
# build falls back to the committed snapshots in lib/data/ (press.snapshot.json,
# active-circles.snapshot.json), so the content can be stale.
# ALLOW_CONTENT_FETCH_FAILURE=1

# Public origin of the intake app (apps/api). Connect forms POST here.
# NEXT_PUBLIC_LOGOS_API_URL=http://localhost:3003

# hCaptcha sitekey for connect/intake forms (visible checkbox).
# NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Outage recovery for the three intake forms. Set to 1 for manual city/country
# entry. Remove and rebuild once the cities API is healthy again.
# NEXT_PUBLIC_FUNNEL_MANUAL_LOCATION=1
