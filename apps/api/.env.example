# Optional comma-separated extra web origins for /api/public/* (any deployment).
# Built-in by deployment:
#   production — https://logos.co only
#   preview/dev — logos.co, http://localhost:*, https://logos-co-web*.vercel.app
CORS_ALLOWED_ORIGINS=

# hCaptcha secret for POST /api/public/afform-submit. Unset = captcha not verified.
HCAPTCHA_SECRET=

# Notion integration — intake funnel (all three connect forms)
NOTION_API_TOKEN=
NOTION_DB_ID=

# Data source to write intake pages to. Required when NOTION_DB_ID points to a
# database with multiple data sources (Notion API 2025-09-03+); pins writes to
# one source so an extra/stray data source cannot break submissions. If unset,
# the database's sole data source is used (errors if there is more than one).
NOTION_DATA_SOURCE_ID=

# Optional: set to 1, true, yes, or on to skip the Notion write on
# POST /api/public/afform-submit. Unset = submit to Notion (default).
FUNNEL_INTAKE_NOTION_DISABLED=

# Steward application (activist-leader-steward) -> n8n/Baserow CRM webhook.
# Server-only secret sent as the X-Webhook-Token header. Value provided privately.
# Unset = steward submissions are not forwarded to n8n (logged and skipped).
N8N_STEWARD_WEBHOOK_TOKEN=
