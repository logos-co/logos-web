      "how": {
        "title": ["How Logos", "Basecamp works."],
        "intro": "The Logos stack is layered and modular. Applications load the capabilities they need through an open, local-first framework.",
        "disclaimer": "Disclaimer: Basecamp is experimental software running on testnet. Apps may change without notice.",
        "layers": [
          {
            "title": "Apps",
            "label": "Layer 3",
            "description": "User-facing applications available in Basecamp that load the capabilities they need through modules.",
            "highlight": "Highlights the Apps layer"
          },
          {
            "title": "Modules",
            "label": "Layer 2",
            "description": "Utilities such as private storage, messaging, and blockchain that are loaded through a built-in package manager when needed.",
            "highlight": "Highlights the Modules layer"
          },
          {
            "title": "Runtime",
            "label": "Layer 1",
            "description": "A lightweight runtime at the core that manages self-contained modules.",
            "highlight": "Highlights the Runtime"
          }
        ],
        "diagram": {
          "title": "Logos stack",
          "hint": "Click a layer or app",
          "apps": [
            "Package Manager",
            "LEZ Wallet",
            "LEZ Explorer",
            "Blockchain",
            "Chat",
            "Storage",
            "Ethereum Wallet",
            "Monero Wallet",
            "Monero Node",
            "Accounts"
          ],
          "modules": [
            {
              "label": "chain",
              "items": ["LEZ Core", "LEZ Indexer", "Blockchain node"]
            },
            {
              "label": "comms",
              "items": ["Chat", "Delivery", "RLN", "libp2p", "Storage"]
            },
            {
              "label": "evm",
              "items": [
                "Tx Sender",
                "Assets",
                "Token List",
                "Fees",
                "Ethereum RPC"
              ]
            },
            {
              "label": "platform",
              "items": [
                "Package Manager",
                "Package Downloader",
                "Capabilities",
                "Module State"
              ]
            }
          ],
          "network": [
            "P2P · discovery · peering · mix",
            "HTTPS / RPC · package catalogue"
          ],
          "runtime": "Logos Runtime",
          "flows": [
            {
              "app": "Package Manager",
              "path": "Package Manager → Package Manager · Package Downloader → HTTPS (package catalogue) → Runtime",
              "description": "Ships with Basecamp. It reads the default catalogue and installs every other app and module.",
              "modules": ["Package Manager", "Package Downloader"],
              "network": 1
            },
            {
              "app": "LEZ Wallet",
              "path": "LEZ Wallet → LEZ Core → HTTPS / RPC (LEZ sequencer) → Runtime",
              "description": "A thin UI over LEZ Core. Keys and wallet state stay on your machine.",
              "modules": ["LEZ Core"],
              "network": 1
            },
            {
              "app": "LEZ Explorer",
              "path": "LEZ Explorer → LEZ Indexer → HTTPS / RPC → Runtime",
              "description": "Reads blocks and transactions through the LEZ Indexer module.",
              "modules": ["LEZ Indexer"],
              "network": 1
            },
            {
              "app": "Blockchain",
              "path": "Blockchain → Blockchain node → P2P · discovery · peering · mix → Runtime",
              "description": "Your own node, talking to peers directly. No RPC provider in between.",
              "modules": ["Blockchain node"],
              "network": 0
            },
            {
              "app": "Chat",
              "path": "Chat → Chat · Delivery → P2P · mix → Runtime",
              "description": "Messages move through Chat and Delivery to peers. They never touch the chain.",
              "modules": ["Chat", "Delivery"],
              "network": 0
            },
            {
              "app": "Storage",
              "path": "Storage → Storage module → P2P → Runtime",
              "description": "The storage module ships with Basecamp. Files move directly between peers.",
              "modules": ["Storage"],
              "network": 0
            },
            {
              "app": "Ethereum Wallet",
              "path": "Ethereum Wallet → Tx Sender · Assets · Token List · Fees · Ethereum RPC · Keystore → EVM endpoints → Runtime",
              "description": "One backend composes six EVM modules. Keys never leave the Keystore module.",
              "modules": [
                "Tx Sender",
                "Assets",
                "Token List",
                "Fees",
                "Ethereum RPC"
              ],
              "network": 1
            },
            {
              "app": "Monero Wallet",
              "path": "Monero Wallet → Wallet Core · Node RPC → Monero → Runtime",
              "description": "A Monero wallet running as Logos modules, inside the same Basecamp shell.",
              "modules": [],
              "network": 1
            },
            {
              "app": "Monero Node",
              "path": "Monero Node → monerod → Monero network → Runtime",
              "description": "Runs monerod locally as a module, so your wallet can talk to your own node.",
              "modules": [],
              "network": 1
            },
            {
              "app": "Accounts",
              "path": "Accounts → Runtime",
              "description": "A UI with no module dependencies. It loads straight onto the runtime.",
              "modules": [],
              "network": null
            }
          ],
          "networkLabel": "Network"
        }
