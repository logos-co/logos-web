{
  "extends": "../packages/config/typescript/base.json",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "paths": {
      "@config/*": ["./src/config/*"],
      "@constants/*": ["./src/constants/*"],
      "@fixtures/*": ["./src/fixtures/*"]
    }
  },
  "include": ["src", "tests", "playwright.config.ts"],
  "exclude": ["node_modules", "test-results"]
}
