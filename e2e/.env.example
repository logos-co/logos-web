# Site under test. Default: a local build served by `pnpm --filter web start`.
# LOGOS_WEB_URL=http://localhost:3000

# Sent as x-e2e-bypass on same-origin requests so the server skips bot checks
# and rate limits. CI reads it from the E2E_BYPASS_TOKEN secret.
# E2E_BYPASS_TOKEN=

# Sitemap entries to request: a number or `all`. Default 30.
# SITEMAP_SAMPLE=30

# 1 fails on console errors against localhost too (useful for the static export).
# E2E_STRICT_CONSOLE=
