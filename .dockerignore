# Keep the Docker build context small and reproducible.
# pnpm-lock.yaml + sources are needed; everything below is not.

# Dependencies (reinstalled inside the image)
**/node_modules
.pnpm-store
**/.pnpm-store

# Build outputs / caches
**/.next
**/out
**/dist
**/build
**/.turbo
**/coverage
**/*.tsbuildinfo

# Published zines are not needed for source analysis or tests
apps/web/public/zine/*.pdf

# VCS / CI
.git
.github

# Local env files — secrets are injected at runtime via docker-compose, never baked
**/.env
**/.env.*
!**/.env.example
!apps/cms/.env.docker.example

# Vercel
**/.vercel

# Editor / OS noise
**/.DS_Store
.claude

# Docker files themselves
**/Dockerfile
!apps/cms/Dockerfile
**/.dockerignore
docker-compose*.yml
!docker-compose.prod.yml
